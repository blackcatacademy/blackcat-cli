#!/usr/bin/env php
<?php
declare(strict_types=1);

use BlackCat\Config\Runtime\Config as RuntimeConfig;
use BlackCat\Core\Database;
use BlackCat\Core\Database\DbBootstrap;

require __DIR__ . '/bootstrap.php';

/**
 * Print a quick DB health snapshot (driver, server version, replica status, ping).
 */

$args = array_slice($argv, 1);
[$options] = parseArgs($args);

initRuntimeConfig($options);
requireBootstrapIfProvided($options);

try {
    ensureDatabaseInitialized($options);

    if (!Database::isInitialized()) {
        fwrite(STDERR, "Database not initialized. Provide --bootstrap=FILE, configure secrets-agent (db.agent.socket_path), or pass --dsn=... --user=... --password=....\n");
        exit(2);
    }

    $db = Database::getInstance();

    $info = [
        'dsn' => $db->id(),
        'driver' => $db->driver(),
        'server' => $db->serverVersion(),
        'replica' => $db->replicaStatus(),
    ];

    $ok = $db->ping();
    $info['ping'] = $ok ? 'ok' : 'fail';

    echo json_encode($info, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) . PHP_EOL;
    exit($ok ? 0 : 1);
} catch (Throwable $e) {
    fwrite(STDERR, 'db-doctor error: ' . $e->getMessage() . PHP_EOL);
    exit(1);
}

/**
 * @param list<string> $args
 * @return array{0:array<string,string>,1:list<string>}
 */
function parseArgs(array $args): array
{
    $options = [];
    $positionals = [];
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--')) {
            [$key, $value] = array_pad(explode('=', substr($arg, 2), 2), 2, '1');
            $options[$key] = $value;
            continue;
        }
        $positionals[] = $arg;
    }
    return [$options, $positionals];
}

/**
 * Initialize blackcat-config runtime config for CLI tools.
 *
 * @param array<string,string> $options
 */
function initRuntimeConfig(array $options): void
{
    $cfg = $options['config'] ?? ($options['config-file'] ?? null);
    if ($cfg === '1') {
        $cfg = '';
    }
    if (is_string($cfg) && trim($cfg) !== '') {
        RuntimeConfig::initFromJsonFileIfNeeded(trim($cfg));
        return;
    }

    RuntimeConfig::tryInitFromFirstAvailableJsonFile();
}

/**
 * @param array<string,string> $options
 */
function requireBootstrapIfProvided(array $options): void
{
    $bootstrap = $options['bootstrap'] ?? '';
    if ($bootstrap === '1') {
        $bootstrap = '';
    }
    if (!is_string($bootstrap) || trim($bootstrap) === '') {
        return;
    }

    $path = trim($bootstrap);
    if (!is_file($path)) {
        throw new RuntimeException('Bootstrap file not found: ' . $path);
    }

    require $path;
}

/**
 * @param array<string,string> $options
 */
function ensureDatabaseInitialized(array $options): void
{
    if (Database::isInitialized()) {
        return;
    }

    if (class_exists(DbBootstrap::class) && RuntimeConfig::isInitialized()) {
        try {
            DbBootstrap::initFromSecretsAgentIfNeeded(appName: 'blackcat-cli:db-doctor');
            return;
        } catch (\Throwable) {
            // Fall through to explicit DSN flags.
        }
    }

    $dsn = resolveDbDsn($options);
    if ($dsn === '') {
        return;
    }

    Database::init([
        'dsn' => $dsn,
        'user' => resolveDbUser($options),
        'pass' => resolveDbPassword($options),
        'appName' => 'blackcat-cli:db',
    ]);
}

/**
 * @param array<string,string> $options
 */
function resolveDbDsn(array $options): string
{
    $dsn = $options['dsn'] ?? '';
    if ($dsn === '1') {
        $dsn = '';
    }
    if (is_string($dsn) && trim($dsn) !== '') {
        return trim($dsn);
    }

    return '';
}

/**
 * @param array<string,string> $options
 */
function resolveDbUser(array $options): ?string
{
    $user = $options['user'] ?? '';
    if ($user === '1') {
        $user = '';
    }
    if (is_string($user) && trim($user) !== '') {
        return trim($user);
    }

    return null;
}

/**
 * @param array<string,string> $options
 */
function resolveDbPassword(array $options): ?string
{
    $pass = $options['password'] ?? ($options['pass'] ?? '');
    if ($pass === '1') {
        $pass = '';
    }
    if (is_string($pass) && trim($pass) !== '') {
        return trim($pass);
    }

    return null;
}
