#!/usr/bin/env php
<?php
declare(strict_types=1);

use BlackCat\Observability\Storage\LocalStore;
use BlackCat\Observability\Export\PrometheusTextExporter;
use BlackCat\Observability\Metrics\MetricsAggregator;

require __DIR__ . '/bootstrap.php';

/**
 * observability
 *
 * Usage:
 *   blackcat observability store:info [--storage-dir=DIR]
 *   blackcat observability events:tail [--limit=10] [--storage-dir=DIR]
 *   blackcat observability events:clear [--storage-dir=DIR]
 *   blackcat observability metrics:snapshot [--storage-dir=DIR]
 *   blackcat observability metrics:tail [--limit=10] [--storage-dir=DIR]
 *   blackcat observability metrics:clear [--storage-dir=DIR]
 *   blackcat observability metrics:export [prom|json] [--no-service-label] [--storage-dir=DIR]
 */

$args = array_slice($argv, 1);
[$options, $positionals] = parseArgs($args);

$cmd = (string)($positionals[0] ?? 'help');

$workspaceRoot = dirname(__DIR__, 2);
$defaultStorage = $workspaceRoot . '/blackcat-observability/var';
$storageDir = (string)($options['storage-dir'] ?? ($options['storage'] ?? (getenv('OBS_STORAGE') ?: $defaultStorage)));

try {
    $store = new LocalStore($storageDir);
} catch (\Throwable $e) {
    err($e->getMessage());
    exit(2);
}

switch ($cmd) {
    case '':
    case 'help':
    case '--help':
    case '-h':
        usage();
        exit(0);

    case 'store:info':
        $eventsPath = $store->eventsFilePath();
        $metricsPath = $store->metricsFilePath();

        $events = $store->events();
        $metrics = $store->metrics();

        $eventsCount = count($events);
        $metricsCount = count($metrics);

        $eventsSize = is_file($eventsPath) ? (int) @filesize($eventsPath) : 0;
        $metricsSize = is_file($metricsPath) ? (int) @filesize($metricsPath) : 0;

        $lastEventTs = $eventsCount > 0 ? (int) ($events[$eventsCount - 1]['timestamp'] ?? 0) : 0;
        $lastMetricTs = $metricsCount > 0 ? (int) ($metrics[$metricsCount - 1]['timestamp'] ?? 0) : 0;

        echo json_encode([
            'storage_dir' => $store->storageDir(),
            'events' => [
                'path' => $eventsPath,
                'count' => $eventsCount,
                'bytes' => $eventsSize,
                'last_ts' => $lastEventTs ?: null,
            ],
            'metrics' => [
                'path' => $metricsPath,
                'count' => $metricsCount,
                'bytes' => $metricsSize,
                'last_ts' => $lastMetricTs ?: null,
            ],
        ], JSON_PRETTY_PRINT) . PHP_EOL;
        exit(0);

    case 'events:tail':
        $limit = (int)($options['limit'] ?? 10);
        if ($limit < 1) {
            $limit = 10;
        }
        $events = $store->events();
        $slice = array_slice($events, -$limit);
        echo json_encode($slice, JSON_PRETTY_PRINT) . PHP_EOL;
        exit(0);

    case 'events:clear':
        $store->clearEvents();
        out('OK');
        exit(0);

    case 'metrics:snapshot':
        $metrics = $store->metrics();
        echo json_encode(MetricsAggregator::sumByName($metrics), JSON_PRETTY_PRINT) . PHP_EOL;
        exit(0);

    case 'metrics:tail':
        $limit = (int)($options['limit'] ?? 10);
        if ($limit < 1) {
            $limit = 10;
        }
        $metrics = $store->metrics();
        $slice = array_slice($metrics, -$limit);
        echo json_encode($slice, JSON_PRETTY_PRINT) . PHP_EOL;
        exit(0);

    case 'metrics:clear':
        $store->clearMetrics();
        out('OK');
        exit(0);

    case 'metrics:export':
        $format = strtolower(trim((string)($positionals[1] ?? 'prom')));
        $noServiceLabel = array_key_exists('no-service-label', $options);

        $metrics = $store->metrics();
        if ($format === 'json') {
            $series = MetricsAggregator::sumBySeries($metrics, !$noServiceLabel);
            echo json_encode($series, JSON_PRETTY_PRINT) . PHP_EOL;
            exit(0);
        }
        if ($format !== 'prom' && $format !== 'prometheus') {
            err("Unsupported format: {$format}");
            usage();
            exit(1);
        }

        echo PrometheusTextExporter::export($metrics, !$noServiceLabel);
        exit(0);

    default:
        err("Unknown command: {$cmd}");
        usage();
        exit(1);
}

function usage(): void
{
    out('observability');
    out('Usage: blackcat observability <command> [options]');
    out('');
    out('Commands:');
    out('  store:info         Print local store paths + counts');
    out('  events:tail        Print last N events as JSON');
    out('  events:clear       Clear events file');
    out('  metrics:snapshot   Aggregate metrics by name');
    out('  metrics:tail       Print last N metric events as JSON');
    out('  metrics:clear      Clear metrics file');
    out('  metrics:export     Export aggregated metrics (prom/json)');
    out('');
    out('Options:');
    out('  --storage-dir=DIR  Override local store directory');
    out('  --limit=N          Tail limit (events:tail, default: 10)');
    out('  --no-service-label Omit the "service" label in metrics:export');
}

function out(string $line): void
{
    echo $line . PHP_EOL;
}

function err(string $line): void
{
    fwrite(STDERR, $line . PHP_EOL);
}

/**
 * @param string[] $args
 * @return array{0:array<string,string|bool>,1:list<string>}
 */
function parseArgs(array $args): array
{
    /** @var array<string,string|bool> $options */
    $options = [];
    /** @var list<string> $positionals */
    $positionals = [];

    while ($args !== []) {
        $arg = array_shift($args);
        if ($arg === '--') {
            $positionals = array_merge($positionals, $args);
            break;
        }

        if (!is_string($arg)) {
            continue;
        }

        if (str_starts_with($arg, '--')) {
            $pair = explode('=', substr($arg, 2), 2);
            $key = $pair[0] ?? '';
            if ($key === '') {
                continue;
            }
            if (count($pair) === 2) {
                $options[$key] = (string) $pair[1];
                continue;
            }

            $next = $args[0] ?? null;
            if (is_string($next) && $next !== '' && !str_starts_with($next, '-')) {
                $options[$key] = (string) array_shift($args);
            } else {
                $options[$key] = true;
            }
            continue;
        }

        $positionals[] = $arg;
    }

    return [$options, $positionals];
}
