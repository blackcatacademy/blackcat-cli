#!/usr/bin/env php
<?php
declare(strict_types=1);

require __DIR__ . '/../src/autoload.php';

// Compatibility wrapper for legacy callers.
// Old path: blackcat-config/bin/config
// New canonical: blackcat config ...

$argv = $argv ?? [];
array_splice($argv, 1, 0, ['config']);

exit(BlackCat\Cli\BlackCatCli::run($argv));

