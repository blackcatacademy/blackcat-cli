#!/usr/bin/env php
<?php
declare(strict_types=1);

require __DIR__ . '/../src/autoload.php';

// Compatibility wrapper for legacy callers.
// Old path: blackcat-usage/bin/usage
// New canonical: blackcat usage ...

$argv = $argv ?? [];
array_splice($argv, 1, 0, ['usage']);

exit(BlackCat\Cli\BlackCatCli::run($argv));

