#!/usr/bin/env php
<?php
declare(strict_types=1);

require __DIR__ . '/../src/autoload.php';

// Compatibility wrapper for legacy callers.
// Old path: blackcat-crypto/bin/crypto
// New canonical: blackcat crypto ...

$argv = $argv ?? [];
array_splice($argv, 1, 0, ['crypto']);

exit(BlackCat\Cli\BlackCatCli::run($argv));

